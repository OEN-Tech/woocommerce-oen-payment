#: includes/class-wc-gateway-oen.php:106 includes/class-wc-gateway-oen.php:125
#: includes/class-wc-gateway-oen.php:242
msgid "Order not found."
msgstr "找不到訂單。"

#: includes/class-wc-gateway-oen.php:114
msgid "Another OEN checkout attempt is already being prepared for this order. Please wait a moment and try again."
msgstr "這張訂單的 OEN 付款正在準備中，請稍後再試。"

#: includes/class-wc-gateway-oen.php:163
msgid "OEN Payment API did not return a checkout URL."
msgstr "OEN 金流 API 沒有回傳付款頁網址。"

#: includes/class-wc-gateway-oen.php:198
msgid "Awaiting OEN off-site payment."
msgstr "等待消費者完成 OEN 繳費。"

#: includes/class-wc-gateway-oen.php:214
msgid "Payment processing failed. Please try again or contact support."
msgstr "付款處理失敗，請再試一次或聯絡客服。"

#: includes/class-wc-gateway-oen.php:249
msgid "OEN only supports refunds for credit card payments."
msgstr "OEN 只支援信用卡付款的退款。"

#: includes/class-wc-gateway-oen.php:258
msgid "This order has no OEN session id, so it cannot be refunded through OEN."
msgstr "這張訂單沒有對應的 OEN 付款紀錄，無法透過 OEN 退款。"

#: includes/class-wc-gateway-oen.php:267
msgid "Refund amount must be greater than zero."
msgstr "退款金額必須大於 0。"

#: includes/class-wc-gateway-oen.php:309
msgid "OEN did not confirm the refund. The order was not marked as refunded."
msgstr "OEN 沒有確認這筆退款，訂單未標記為已退款。"

#. translators: 1: refund amount, 2: OEN refund id
#: includes/class-wc-gateway-oen.php:323
#, php-format
msgid "Refunded %1$d via OEN (refund %2$s)."
msgstr "已透過 OEN 退款 %1$d 元（退款編號 %2$s）。"

#: includes/class-wc-gateway-oen.php:358
msgid "We could not verify your existing OEN checkout session. Please try again in a moment."
msgstr "無法確認這張訂單目前的 OEN 付款，請稍後再試。"

#: includes/class-wc-gateway-oen.php:415
msgid "Your existing OEN checkout session is still active, but its checkout URL is unavailable. Please try again in a moment."
msgstr "這張訂單的 OEN 付款仍在進行中，但暫時取不到付款頁網址，請稍後再試。"

#: includes/class-wc-gateway-oen.php:475
msgid "The previous OEN checkout attempt for this order could not be cancelled after the payment method was changed. If it is still open in the buyer's browser it may result in a second payment — check for a duplicate before refunding."
msgstr "改選付款方式後，無法取消這張訂單先前的 OEN 付款。消費者的瀏覽器若仍開著舊的付款頁，可能會付款兩次；退款前請先確認是否重複付款。"

#: includes/class-wc-gateway-oen.php:586
msgid "We could not safely verify your existing OEN checkout session. Please try again in a moment."
msgstr "無法安全確認這張訂單目前的 OEN 付款，請稍後再試。"

